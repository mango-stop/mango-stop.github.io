---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Giscus from '../../components/Giscus.astro';
import { CATEGORIES, formatDate } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const category = CATEGORIES[post.data.category];
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <div class="meta">
        <a class="category-badge" href={`${base}/categories/${category.slug}/`}>
          {category.label}
        </a>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>
      </div>
      <h1>{post.data.title}</h1>
      {
        post.data.tags.length > 0 && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`${base}/tags/${tag}/`}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <Giscus />
  </article>

  <style>
    /* 본문은 흰 종이 카드 위에 — 페이지 배경(크림색)은 양옆에 그대로 보인다 */
    article {
      background: var(--paper);
      border: 2px solid var(--border);
      box-shadow: var(--shadow-sm);
      padding: 2.2rem 2.4rem 2.6rem;
    }

    @media (max-width: 640px) {
      article {
        padding: 1.5rem 1.15rem 1.8rem;
        margin: 0 -0.35rem;
      }
    }

    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.2rem;
      border-bottom: 3px solid var(--border);
    }

    .meta {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    h1 {
      margin: 0.6rem 0 0.5rem;
      font-size: clamp(1.7rem, 4vw, 2.3rem);
      font-weight: 900;
    }

    .tags {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }
  </style>
</BaseLayout>
