---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const all = await getCollection('publications');
const byDateDesc = (a: (typeof all)[number], b: (typeof all)[number]) =>
  b.data.date.localeCompare(a.data.date);

const journals = all.filter((p) => p.data.type === 'journal').sort(byDateDesc);
const conferences = all.filter((p) => p.data.type === 'conference').sort(byDateDesc);

const scopeLabel: Record<string, string> = { domestic: '국내', international: '국외' };
---

<BaseLayout title="Portfolio" wide>
  <h1 class="page-title">Portfolio</h1>
  <p class="count">Journal {journals.length} · Conference {conferences.length}</p>

  {
    all.length === 0 && (
      <p class="empty">아직 등록된 논문/발표가 없습니다.</p>
    )
  }

  {
    journals.length > 0 && (
      <section class="pub-section">
        <h2>Journal</h2>
        <div class="pub-table-wrap">
          <table class="pub-table">
            <thead>
              <tr>
                <th>국내/국외</th>
                <th>논문명</th>
                <th>학술지명</th>
                <th>게재상황</th>
                <th>일자</th>
              </tr>
            </thead>
            <tbody>
              {journals.map((p) => (
                <tr>
                  <td>
                    <span class="scope-badge" data-scope={p.data.scope}>
                      {scopeLabel[p.data.scope]}
                    </span>
                  </td>
                  <td>
                    {p.data.link ? (
                      <a href={p.data.link} target="_blank" rel="noopener">
                        {p.data.title}
                      </a>
                    ) : (
                      p.data.title
                    )}
                  </td>
                  <td>{p.data.venue}</td>
                  <td>{p.data.status}</td>
                  <td>{p.data.date}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    conferences.length > 0 && (
      <section class="pub-section">
        <h2>Conference</h2>
        <div class="pub-table-wrap">
          <table class="pub-table">
            <thead>
              <tr>
                <th>국내/국외</th>
                <th>논문/발표명</th>
                <th>학회명</th>
                <th>게재상황</th>
                <th>일자</th>
              </tr>
            </thead>
            <tbody>
              {conferences.map((p) => (
                <tr>
                  <td>
                    <span class="scope-badge" data-scope={p.data.scope}>
                      {scopeLabel[p.data.scope]}
                    </span>
                  </td>
                  <td>
                    {p.data.link ? (
                      <a href={p.data.link} target="_blank" rel="noopener">
                        {p.data.title}
                      </a>
                    ) : (
                      p.data.title
                    )}
                  </td>
                  <td>{p.data.venue}</td>
                  <td>{p.data.status}</td>
                  <td>{p.data.date}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <style>
    .page-title {
      font-size: 1.7rem;
      margin: 0 0 0.2rem;
    }

    .count {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0 0 1.6rem;
      padding-bottom: 1.2rem;
      border-bottom: 3px solid var(--border);
    }

    .empty {
      color: var(--text-muted);
    }

    .pub-section {
      margin-bottom: 2.4rem;
    }

    .pub-section h2 {
      font-size: 1.05rem;
      margin: 0 0 0.9rem;
    }

    .pub-table-wrap {
      overflow-x: auto;
      border: 2px solid var(--border);
      border-radius: 0;
      box-shadow: var(--shadow-sm);
    }

    .pub-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    .pub-table th,
    .pub-table td {
      padding: 0.7rem 0.9rem;
      text-align: left;
      border-bottom: 2px solid var(--border);
      white-space: nowrap;
    }

    .pub-table td:nth-child(2) {
      white-space: normal;
      min-width: 14rem;
    }

    .pub-table th {
      background: var(--bg-soft);
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .pub-table tbody tr:last-child td {
      border-bottom: none;
    }

    .pub-table a {
      color: var(--text);
      font-weight: 600;
    }

    .pub-table a:hover {
      color: var(--accent);
    }

    .scope-badge {
      display: inline-block;
      font-size: 0.74rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      padding: 0.12rem 0.5rem;
      border-radius: 0;
      border: 2px solid var(--border);
      box-shadow: 2px 2px 0 var(--text);
    }

    .scope-badge[data-scope='domestic'] {
      color: #1c1747;
      background: #c7d2fe;
    }

    .scope-badge[data-scope='international'] {
      color: #052e22;
      background: #86efac;
    }

    :global(html.dark) .scope-badge[data-scope='domestic'] {
      color: #eef1ff;
      background: #4f46e5;
    }

    :global(html.dark) .scope-badge[data-scope='international'] {
      color: #eafff3;
      background: #059669;
    }
  </style>
</BaseLayout>
