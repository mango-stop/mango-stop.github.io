---
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../lib/site';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  /** OG 카드 이미지 (사이트 기준 절대 경로 또는 전체 URL) */
  image?: string;
}

const { title, description = SITE_DESCRIPTION, wide = false, image } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const ogImage = image
  ? new URL(image, Astro.site ?? Astro.url).href
  : undefined;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="site-base" content={base} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${base}/rss.xml`} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ko_KR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // FOUC 방지: 렌더링 전에 저장된 테마를 적용
      (() => {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={`${base}/`}>{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="주 메뉴">
          {
            Object.values(CATEGORIES).map((c) => (
              <a href={`${base}/categories/${c.slug}/`}>{c.label}</a>
            ))
          }
          <a href={`${base}/portfolio/`}>Portfolio</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
        <div class="header-actions">
          <a class="icon-link" href={`${base}/search/`} aria-label="Search" title="Search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </a>
          <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <span class="icon-stack">
              <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.5"></circle>
                <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path>
              </svg>
              <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {SITE_TITLE}
        <span class="sep">·</span>
        <a href="https://github.com/mango-stop" target="_blank" rel="noopener">GitHub</a>
      </p>
      <div class="visit-counter" id="visit-counter" hidden>
        <span class="vc-chip vc-today">오늘 <b id="vc-today">0</b></span>
        <span class="vc-chip vc-total">전체 <b id="vc-total">0</b></span>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <script>
      // 본문에 삽입된 "블로그 글 카드"(.post-embed)를 실제 카드로 채워 넣는다.
      const embeds = document.querySelectorAll('.post-embed[data-slug]');
      if (embeds.length > 0) {
        const base = document.querySelector('meta[name="site-base"]')?.getAttribute('content') || '';
        fetch(`${base}/posts-index.json`)
          .then((res) => res.json())
          .then((index) => {
            embeds.forEach((el) => {
              const slug = el.getAttribute('data-slug');
              const post = slug ? index[slug] : undefined;
              if (!post) {
                el.remove();
                return;
              }
              const thumb = post.cover
                ? `<div class="embed-thumb"><img src="${post.cover}" alt="" loading="lazy" /></div>`
                : '';
              el.outerHTML = `
                <a class="embed-card" href="${base}/posts/${slug}/">
                  ${thumb}
                  <div class="embed-body">
                    <span class="embed-cat" style="color:${post.categoryColor}">${post.category}</span>
                    <p class="embed-title">${post.title}</p>
                    <p class="embed-desc">${post.description}</p>
                    <span class="embed-date">${post.date}</span>
                  </div>
                </a>
              `;
            });
          })
          .catch(() => {});
      }
    </script>

    <script>
      // 방문자 카운터: Cloudflare Worker(KV)에서 오늘/전체 방문 수를 받아 푸터에 표시.
      // 같은 브라우저는 하루(KST)에 한 번만 집계되고, 실패하면 조용히 숨긴다.
      (async () => {
        const el = document.getElementById('visit-counter');
        if (!el) return;
        try {
          const kstDay = new Date(Date.now() + 9 * 60 * 60 * 1000).toISOString().slice(0, 10);
          let alreadyCounted = false;
          try {
            alreadyCounted = localStorage.getItem('visited-day') === kstDay;
          } catch {}

          const res = await fetch(
            `https://blog-visit-counter.msj121702.workers.dev/hit${alreadyCounted ? '?count=0' : ''}`
          );
          if (!res.ok) return;
          const { today, total } = await res.json();
          try {
            localStorage.setItem('visited-day', kstDay);
          } catch {}

          const todayEl = document.getElementById('vc-today');
          const totalEl = document.getElementById('vc-total');
          if (todayEl) todayEl.textContent = Number(today).toLocaleString();
          if (totalEl) totalEl.textContent = Number(total).toLocaleString();
          el.hidden = false;
        } catch {}
      })();
    </script>

    <script>
      // 본문 표: 열의 내용을 보고 정렬과 줄바꿈을 자동 조정한다.
      // 숫자·범위 위주 열(점수, 시각, 크기 등)은 가운데 정렬 + 줄바꿈 금지,
      // 짧은 라벨 열(R01, 매수 등)은 줄바꿈만 금지, 긴 문장 열은 그대로 둔다.
      const NUMERICISH =
        /^[\d\s.,%±+\-~×:()/·억조원년월일주BG약이상미만하]+$/;

      document.querySelectorAll('.prose table').forEach((table) => {
        const rows = [...table.querySelectorAll('tbody tr')];
        if (rows.length === 0) return;
        const headCells = [...(table.querySelectorAll('thead th') ?? [])];
        const colCount = Math.max(...rows.map((r) => r.children.length));

        for (let c = 0; c < colCount; c++) {
          const cells = rows.map((r) => r.children[c]).filter(Boolean);
          const texts = cells
            .map((el) => (el.textContent ?? '').trim())
            .filter((t) => t.length > 0 && t !== '-');
          if (texts.length === 0) continue;

          const numericish = texts.filter((t) => /\d/.test(t) && NUMERICISH.test(t));
          if (numericish.length / texts.length >= 0.8) {
            cells.forEach((el) => el.classList.add('cell-num'));
            headCells[c]?.classList.add('cell-num');
          } else if (texts.every((t) => t.length <= 10)) {
            cells.forEach((el) => el.classList.add('cell-short'));
          }
        }
      });
    </script>

    <script>
      // 스크롤 등장 애니메이션: reduced-motion이 아닐 때만 무장(arm)한다
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-armed');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>

    <style>
      main.wide {
        max-width: 60rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--header-bg);
        border-bottom: 3px solid var(--border);
      }

      .header-inner {
        max-width: 60rem;
        margin: 0 auto;
        padding: 0.8rem 1.35rem;
        display: flex;
        align-items: center;
        gap: 1.2rem;
      }

      .site-title {
        font-weight: 900;
        font-size: 1.08rem;
        letter-spacing: -0.02em;
        color: var(--text);
        display: inline-block;
        transform-origin: 50% 80%;
        white-space: nowrap;
      }

      .site-title:hover {
        text-decoration: none;
        color: var(--accent);
        animation: wiggle 0.5s var(--ease-spring);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin-left: auto;
        min-width: 0;
      }

      .site-nav a {
        position: relative;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.15s ease;
        padding-bottom: 2px;
        white-space: nowrap;
      }

      .site-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s var(--ease-spring);
      }

      .site-nav a:hover {
        color: var(--text);
        text-decoration: none;
      }

      @media (hover: hover) {
        .site-nav a:hover::after {
          transform: scaleX(1);
        }
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
      }

      .icon-link {
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        padding: 0.35rem;
        margin: -0.35rem;
      }

      .icon-link:hover {
        color: var(--text);
      }

      /* 모바일: 1행 = 제목 + 아이콘, 2행 = 가로 스크롤 메뉴 */
      @media (max-width: 640px) {
        .header-inner {
          flex-wrap: wrap;
          row-gap: 0.55rem;
          padding: 0.7rem 1.1rem 0.65rem;
        }

        .site-nav {
          order: 3;
          flex-basis: 100%;
          margin-left: 0;
          gap: 1rem;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }

        .site-nav::-webkit-scrollbar {
          display: none;
        }

        .header-actions {
          margin-left: auto;
        }
      }

      #theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        background: var(--bg-card);
        border: 2px solid var(--border);
        border-radius: 0;
        padding: 0.2rem;
        cursor: pointer;
        color: var(--text);
        box-shadow: 2px 2px 0 var(--text);
        transition:
          transform 0.2s var(--ease-spring),
          box-shadow 0.2s var(--ease-spring);
      }

      #theme-toggle:hover {
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0 var(--text);
      }

      #theme-toggle:active {
        transform: translate(1px, 1px);
        box-shadow: 0 0 0 var(--text);
      }

      /* 터치 기기에서는 탭 타깃을 키운다 */
      @media (pointer: coarse) {
        #theme-toggle {
          width: 2.25rem;
          height: 2.25rem;
        }

        .icon-link {
          padding: 0.55rem;
          margin: -0.55rem;
        }
      }

      .icon-stack {
        position: relative;
        width: 15px;
        height: 15px;
        display: inline-block;
      }

      .icon-stack svg {
        position: absolute;
        inset: 0;
        transition:
          opacity 0.3s var(--ease-spring),
          transform 0.4s var(--ease-spring);
      }

      .icon-stack .icon-moon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
      }

      :global(html.dark) .icon-stack .icon-sun {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
      }

      :global(html.dark) .icon-stack .icon-moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      .site-footer {
        border-top: 3px solid var(--border);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.83rem;
      }

      .sep {
        margin: 0 0.35rem;
        opacity: 0.5;
      }

      .site-footer a {
        color: var(--text-muted);
      }

      .site-footer a:hover {
        color: var(--text);
      }

      /* 방문자 카운터: 태그 칩과 같은 브루탈리스트 스티커 스타일 */
      .visit-counter {
        display: flex;
        justify-content: center;
        gap: 0.6rem;
        margin: 0.7rem 0 1.1rem;
      }

      .visit-counter[hidden] {
        display: none;
      }

      .vc-chip {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        padding: 0.16rem 0.7rem;
        border: 2px solid var(--border);
        background: var(--bg-card);
        box-shadow: 2px 2px 0 var(--text);
        font-size: 0.76rem;
        font-weight: 700;
        color: var(--text);
        animation: vc-pop 0.4s var(--ease-spring) backwards;
      }

      .vc-chip b {
        font-size: 0.92rem;
        font-weight: 900;
        font-variant-numeric: tabular-nums;
      }

      .vc-today {
        background: var(--accent2);
        transform: rotate(-1.5deg);
      }

      .vc-total {
        transform: rotate(1deg);
        animation-delay: 0.08s;
      }

      @keyframes vc-pop {
        from {
          opacity: 0;
          transform: translateY(8px) scale(0.85);
        }
      }
    </style>
  </body>
</html>
