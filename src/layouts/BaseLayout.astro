---
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../lib/site';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description = SITE_DESCRIPTION, wide = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="site-base" content={base} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <title>{pageTitle}</title>
    <script is:inline>
      // FOUC 방지: 렌더링 전에 저장된 테마를 적용
      (() => {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-title" href={`${base}/`}>{SITE_TITLE}</a>
        <nav class="site-nav" aria-label="주 메뉴">
          {
            Object.values(CATEGORIES).map((c) => (
              <a href={`${base}/categories/${c.slug}/`}>{c.label}</a>
            ))
          }
          <a href={`${base}/portfolio/`}>Portfolio</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
        <div class="header-actions">
          <a class="icon-link" href={`${base}/search/`} aria-label="Search" title="Search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
          </a>
          <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">
            <span class="icon-stack">
              <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <circle cx="12" cy="12" r="4.5"></circle>
                <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8"></path>
              </svg>
              <svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
              </svg>
            </span>
          </button>
        </div>
      </div>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {SITE_TITLE}
        <span class="sep">·</span>
        <a href="https://github.com/mango-stop" target="_blank" rel="noopener">GitHub</a>
      </p>
    </footer>

    <script>
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    </script>

    <script>
      // 본문에 삽입된 "블로그 글 카드"(.post-embed)를 실제 카드로 채워 넣는다.
      const embeds = document.querySelectorAll('.post-embed[data-slug]');
      if (embeds.length > 0) {
        const base = document.querySelector('meta[name="site-base"]')?.getAttribute('content') || '';
        fetch(`${base}/posts-index.json`)
          .then((res) => res.json())
          .then((index) => {
            embeds.forEach((el) => {
              const slug = el.getAttribute('data-slug');
              const post = slug ? index[slug] : undefined;
              if (!post) {
                el.remove();
                return;
              }
              const thumb = post.cover
                ? `<div class="embed-thumb"><img src="${post.cover}" alt="" loading="lazy" /></div>`
                : '';
              el.outerHTML = `
                <a class="embed-card" href="${base}/posts/${slug}/">
                  ${thumb}
                  <div class="embed-body">
                    <span class="embed-cat" style="color:${post.categoryColor}">${post.category}</span>
                    <p class="embed-title">${post.title}</p>
                    <p class="embed-desc">${post.description}</p>
                    <span class="embed-date">${post.date}</span>
                  </div>
                </a>
              `;
            });
          })
          .catch(() => {});
      }
    </script>

    <script>
      // 스크롤 등장 애니메이션: reduced-motion이 아닐 때만 무장(arm)한다
      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('reveal-armed');
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      }
    </script>

    <style>
      main.wide {
        max-width: 60rem;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--header-bg);
        border-bottom: 3px solid var(--border);
      }

      .header-inner {
        max-width: 60rem;
        margin: 0 auto;
        padding: 0.8rem 1.35rem;
        display: flex;
        align-items: center;
        gap: 1.2rem;
      }

      .site-title {
        font-weight: 900;
        font-size: 1.08rem;
        letter-spacing: -0.02em;
        color: var(--text);
        display: inline-block;
        transform-origin: 50% 80%;
        white-space: nowrap;
      }

      .site-title:hover {
        text-decoration: none;
        color: var(--accent);
        animation: wiggle 0.5s var(--ease-spring);
      }

      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin-left: auto;
        min-width: 0;
      }

      .site-nav a {
        position: relative;
        color: var(--text-muted);
        font-size: 0.9rem;
        font-weight: 600;
        transition: color 0.15s ease;
        padding-bottom: 2px;
        white-space: nowrap;
      }

      .site-nav a::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 100%;
        height: 2px;
        background: var(--accent);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.25s var(--ease-spring);
      }

      .site-nav a:hover {
        color: var(--text);
        text-decoration: none;
      }

      @media (hover: hover) {
        .site-nav a:hover::after {
          transform: scaleX(1);
        }
      }

      .header-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
      }

      .icon-link {
        display: inline-flex;
        align-items: center;
        color: var(--text-muted);
        padding: 0.35rem;
        margin: -0.35rem;
      }

      .icon-link:hover {
        color: var(--text);
      }

      /* 모바일: 1행 = 제목 + 아이콘, 2행 = 가로 스크롤 메뉴 */
      @media (max-width: 640px) {
        .header-inner {
          flex-wrap: wrap;
          row-gap: 0.55rem;
          padding: 0.7rem 1.1rem 0.65rem;
        }

        .site-nav {
          order: 3;
          flex-basis: 100%;
          margin-left: 0;
          gap: 1rem;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }

        .site-nav::-webkit-scrollbar {
          display: none;
        }

        .header-actions {
          margin-left: auto;
        }
      }

      #theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.9rem;
        height: 1.9rem;
        background: var(--bg-card);
        border: 2px solid var(--border);
        border-radius: 0;
        padding: 0.2rem;
        cursor: pointer;
        color: var(--text);
        box-shadow: 2px 2px 0 var(--text);
        transition:
          transform 0.2s var(--ease-spring),
          box-shadow 0.2s var(--ease-spring);
      }

      #theme-toggle:hover {
        transform: translate(-1px, -1px);
        box-shadow: 3px 3px 0 var(--text);
      }

      #theme-toggle:active {
        transform: translate(1px, 1px);
        box-shadow: 0 0 0 var(--text);
      }

      /* 터치 기기에서는 탭 타깃을 키운다 */
      @media (pointer: coarse) {
        #theme-toggle {
          width: 2.25rem;
          height: 2.25rem;
        }

        .icon-link {
          padding: 0.55rem;
          margin: -0.55rem;
        }
      }

      .icon-stack {
        position: relative;
        width: 15px;
        height: 15px;
        display: inline-block;
      }

      .icon-stack svg {
        position: absolute;
        inset: 0;
        transition:
          opacity 0.3s var(--ease-spring),
          transform 0.4s var(--ease-spring);
      }

      .icon-stack .icon-moon {
        opacity: 0;
        transform: rotate(-90deg) scale(0.5);
      }

      :global(html.dark) .icon-stack .icon-sun {
        opacity: 0;
        transform: rotate(90deg) scale(0.5);
      }

      :global(html.dark) .icon-stack .icon-moon {
        opacity: 1;
        transform: rotate(0deg) scale(1);
      }

      .site-footer {
        border-top: 3px solid var(--border);
        text-align: center;
        color: var(--text-muted);
        font-size: 0.83rem;
      }

      .sep {
        margin: 0 0.35rem;
        opacity: 0.5;
      }

      .site-footer a {
        color: var(--text-muted);
      }

      .site-footer a:hover {
        color: var(--text);
      }
    </style>
  </body>
</html>
