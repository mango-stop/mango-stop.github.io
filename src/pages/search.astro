---
import Search from 'astro-pagefind/components/Search.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search">
  <h1 class="page-title">Search</h1>
  <Search
    id="search"
    className="site-search"
    searchboxOptions={{ placeholder: '검색어를 입력하세요' }}
  />

  <style is:global>
    /* Pagefind(@pagefind/component-ui)는 --pf-* 토큰으로 테마를 노출한다.
       html:root(0,1,1)로 라이브러리의 :root(0,1,0)보다 우선 적용.
       사이트 토큰(var(--text) 등)을 참조하므로 다크모드도 자동으로 따라간다. */
    html:root {
      --pf-text: var(--text);
      --pf-text-secondary: var(--text-muted);
      --pf-text-muted: var(--text-muted);
      --pf-background: var(--paper);
      --pf-border: var(--border);
      --pf-border-focus: var(--border);
      --pf-skeleton: var(--bg-soft);
      --pf-skeleton-shine: var(--bg-card);
      --pf-hover: var(--bg-soft);
      --pf-mark: var(--accent-strong);
      --pf-shadow-sm: 3px 3px 0 var(--text);
      --pf-shadow-md: 4px 4px 0 var(--text);
      --pf-shadow-lg: 6px 6px 0 var(--text);
      --pf-outline-focus: var(--accent);
      --pf-font:
        'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont,
        'Apple SD Gothic Neo', 'Noto Sans KR', 'Segoe UI', sans-serif;
      --pf-border-radius: 0;
      --pf-searchbox-max-width: 100%;
      --pf-input-height: 48px;
      --pf-input-font-size: 16px;
      --pf-summary-font-size: 13px;
      --pf-result-title-font-size: 16px;
      --pf-result-excerpt-font-size: 14px;
      --pf-results-gap: 12px;
    }

    /* 라이브러리가 :is(*, #\#)×3(ID 3개급)로 구조 스타일의 우선순위를 올려두므로,
       구조를 덮어쓰려면 같은 트릭에 하나를 더해(×4) 이긴다. */
    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-searchbox-input {
      border-width: 2px;
      font-weight: 600;
      box-shadow: var(--shadow-sm);
    }

    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-searchbox-input::placeholder {
      color: var(--text-muted);
      font-weight: 500;
      opacity: 1;
    }

    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-result-card {
      border-width: 2px;
      box-shadow: var(--shadow-sm);
      transition:
        transform 0.2s var(--ease-spring),
        box-shadow 0.2s var(--ease-spring);
    }

    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-result-card:hover {
      border-color: var(--border);
      transform: translate(-2px, -2px);
      box-shadow: var(--shadow-md);
    }

    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-result-title {
      font-weight: 800;
    }

    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-result-excerpt mark,
    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-heading-excerpt mark,
    :is(*, #\#):is(*, #\#):is(*, #\#):is(*, #\#) .pf-searchbox-result-excerpt mark {
      background: var(--accent2);
      color: var(--text);
      font-weight: 700;
      padding: 0 0.15em;
    }
  </style>
</BaseLayout>
