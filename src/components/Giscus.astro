<section class="comments">
  <script is:inline>
    // 블로그와 같은 브루탈리스트 톤의 giscus 커스텀 테마(CSS)를 로드한다.
    // FOUC 방지 스크립트가 이미 html.dark를 설정해둔 뒤라 처음부터 올바른 테마로 뜬다.
    (function () {
      const base = document.querySelector('meta[name="site-base"]')?.getAttribute('content') || '';
      const isDark = document.documentElement.classList.contains('dark');
      const themeUrl = `${location.origin}${base}/giscus-theme-${isDark ? 'dark' : 'light'}.css`;

      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.async = true;
      s.crossOrigin = 'anonymous';
      const attrs = {
        'data-repo': 'mango-stop/mango-stop.github.io',
        'data-repo-id': 'R_kgDOTbu0UQ',
        'data-category': 'Announcements',
        'data-category-id': 'DIC_kwDOTbu0Uc4DBZ3-',
        'data-mapping': 'pathname',
        'data-strict': '0',
        'data-reactions-enabled': '1',
        'data-emit-metadata': '0',
        'data-input-position': 'bottom',
        'data-theme': themeUrl,
        'data-lang': 'ko',
      };
      for (const key in attrs) s.setAttribute(key, attrs[key]);
      document.currentScript.parentNode.appendChild(s);
    })();
  </script>
</section>

<script>
  // 다크모드 토글과 giscus 커스텀 테마(CSS) 동기화
  function syncGiscusTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    if (!iframe) return;
    const base = document.querySelector('meta[name="site-base"]')?.getAttribute('content') || '';
    const isDark = document.documentElement.classList.contains('dark');
    const theme = `${location.origin}${base}/giscus-theme-${isDark ? 'dark' : 'light'}.css`;
    iframe.contentWindow?.postMessage(
      { giscus: { setConfig: { theme } } },
      'https://giscus.app'
    );
  }

  const observer = new MutationObserver(syncGiscusTheme);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['class'],
  });
</script>

<style>
  .comments {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 3px solid var(--border);
  }
</style>
