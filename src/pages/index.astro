---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostTile from '../components/PostTile.astro';
import { CATEGORIES, SITE_DESCRIPTION } from '../lib/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const home = await getEntry('home', 'home');
const heroTitle = home?.data.title ?? '학부연구생의 연구 기록';
const heroTagline = home?.data.tagline ?? SITE_DESCRIPTION;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const countByCategory = Object.fromEntries(
  Object.keys(CATEGORIES).map((key) => [
    key,
    posts.filter((p) => p.data.category === key).length,
  ])
);
---

<BaseLayout wide>
  <section class="hero">
    <h1>{heroTitle}</h1>
    <p class="tagline">{heroTagline}</p>
    <div class="category-links">
      {
        Object.entries(CATEGORIES).map(([key, c]) => (
          <a class="category-link" href={`${base}/categories/${c.slug}/`}>
            {c.label}
            <span class="cat-count">{countByCategory[key]}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="posts">
    <div class="grid">
      {posts.map((post) => <PostTile post={post} />)}
    </div>
  </section>

  <style>
    .hero {
      padding: 3.4rem 0 2.8rem;
      border-bottom: 3px solid var(--border);
      margin-bottom: 2.2rem;
    }

    .hero h1 {
      font-size: clamp(2.1rem, 5.5vw, 3.4rem);
      font-weight: 900;
      margin: 0 0 0.7rem;
      line-height: 1.15;
    }

    .tagline {
      color: var(--text-muted);
      font-size: 1.05rem;
      font-weight: 600;
      margin: 0 0 1.8rem;
      max-width: 34rem;
    }

    .category-links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .category-link {
      display: inline-flex;
      align-items: baseline;
      gap: 0.45rem;
      padding: 0.4rem 0.85rem;
      color: var(--text);
      font-size: 0.92rem;
      font-weight: 700;
      background: var(--bg-card);
      border: 2px solid var(--border);
      box-shadow: 2px 2px 0 var(--text);
      transition:
        transform 0.2s var(--ease-spring),
        box-shadow 0.2s var(--ease-spring);
    }

    .category-links a:nth-child(3n + 1) {
      transform: rotate(-1.5deg);
    }

    .category-links a:nth-child(3n + 2) {
      transform: rotate(1deg);
    }

    .category-links a:nth-child(3n + 3) {
      transform: rotate(-0.8deg);
    }

    @media (hover: hover) {
      .category-link:hover {
        text-decoration: none;
        color: var(--accent-strong);
        transform: translate(-2px, -2px) rotate(0deg);
        box-shadow: 4px 4px 0 var(--text);
      }
    }

    .category-link:active {
      transform: translate(1px, 1px) rotate(0deg);
      box-shadow: 0 0 0 var(--text);
    }

    .cat-count {
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0 0.4rem;
      background: var(--accent2);
      color: var(--text);
      border: 2px solid var(--border);
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(22rem, 1fr));
      gap: 1rem;
      align-items: stretch;
    }

    @media (max-width: 480px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
